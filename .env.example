# Copier ce fichier en .env et remplir les vraies valeurs. Ne jamais committer .env.

# Numéro WhatsApp pro, chiffres uniquement avec l'indicatif (ex. 237600000000)
WHATSAPP_NUMBER=

# Facultatif : chemins des PDF du CV (valeurs par défaut ci-dessous)
# CV_PDF_FR=/cv/cv-fr.pdf
# CV_PDF_EN=/cv/cv-en.pdf

# Facultatif : port local du site (défaut 8080)
# FRONTEND_PORT=8080

# Backend V2 : Docker Compose (DB_USER et DB_PASSWORD obligatoires)
# Remplacer le mot de passe fictif avant tout déploiement.
DB_USER=portfolio
DB_PASSWORD=example-local-password
# Hors Docker uniquement :
# DB_URL=jdbc:postgresql://localhost:5432/portfolio

# SMTP : désactiver auth et STARTTLS uniquement pour Mailpit en local.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
CONTACT_TO=contact@example.com
CONTACT_FROM=portfolio@example.com
API_DOCS_ENABLED=false

# Sauvegarde quotidienne à 02:30 (Africa/Douala)
BACKUP_RETENTION_DAYS=7
